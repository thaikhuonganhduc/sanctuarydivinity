<mxfile host="app.diagrams.net"><diagram name="Use Case tổng quan"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Website SANCTUARY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="240" y="20" width="880" height="1150" as="geometry"/></mxCell><mxCell id="c4" value="UC01. Vào web bằng mã athlete" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="230" height="56" as="geometry"/></mxCell><mxCell id="c5" value="UC02. Xem, lọc và sắp xếp sản phẩm" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280" y="150" width="230" height="56" as="geometry"/></mxCell><mxCell id="c6" value="UC03. Xem chi tiết sản phẩm" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280" y="230" width="230" height="56" as="geometry"/></mxCell><mxCell id="c7" value="UC05. Xem và lọc đánh giá" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280" y="310" width="230" height="56" as="geometry"/></mxCell><mxCell id="c8" value="UC06. Quản lý giỏ hàng" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280" y="390" width="230" height="56" as="geometry"/></mxCell><mxCell id="c9" value="UC07. Đặt hàng (thanh toán)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280" y="470" width="230" height="56" as="geometry"/></mxCell><mxCell id="c10" value="UC09. Đổi tiền tệ hiển thị" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280" y="550" width="230" height="56" as="geometry"/></mxCell><mxCell id="c11" value="UC10. Gửi tin nhắn